# Copy to .env and fill in. Never commit the real .env — it is git-ignored.

# --- Database ---
# Postgres connection string, e.g. postgresql://user:password@localhost:5432/furniture
DATABASE_URL=

# --- Auth ---
# Long random string. There is a "default_secret" fallback in src/app.ts — do not rely on it.
JWT_SECRET=

# --- Sanity (product catalogue) ---
SANITY_PROJECT_ID=
SANITY_DATASET=
SANITY_API_VERSION=
# Only needed for writes / private datasets. Currently commented out in src/lib/sanity.ts.
SANITY_TOKEN=

# --- Paystack (added in M2) ---
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
# Where Paystack redirects the customer after payment (UI only — never trusted as proof of payment)
PAYSTACK_CALLBACK_URL=

# --- Server ---
# Hosting platforms inject this. src/server.ts currently hardcodes 4000 — must read PORT before M4.
PORT=3000